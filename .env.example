NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/
MODEL_ID=nvidia/nemotron-3-super-120b-a12b
# Generate locally with npm run setup. Set a separate random value on Vercel.
STATE_SIGNING_SECRET=
# Optional verified prices in USD per million tokens. Cost is hidden when unset.
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=
# Hosted live analysis is locked behind a private code and a persistent $2 allocation.
# Vercel deployments always enforce protection. Use LIVE_PROTECTION=1 to test locally.
LIVE_ACCESS_CODE=
LIVE_PROTECTION=
# Connect a private Vercel Blob store; never expose its token to the browser.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
